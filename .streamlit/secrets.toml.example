# Streamlit Community Cloud: cole em Settings > Secrets.
# Chave mestra Fernet usada para criptografar o .env (gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ERP_MASTER_KEY = "cole-aqui-sua-chave-fernet"

# Senha inicial do usuário admin quando o banco é criado do zero
ERP_ADMIN_PASSWORD = "troque-esta-senha"

# Banco de dados no FTP: necessário para restaurar o banco após reinício do app
FTP_HOST = "meuftp.exemplo.com.br"
FTP_PORT = "21"
FTP_USER = ""
FTP_PASSWORD = ""
FTP_BASE_DIR = "/backup_obra"
FTP_TLS = "0"

# Opcional: AWS S3 (o .env criptografado gravado pela tela tem prioridade)
# AWS_ACCESS_KEY_ID = ""
# AWS_SECRET_ACCESS_KEY = ""
# S3_BUCKET = ""

# Opcional: 1 = carrega a simulação de demonstração na primeira execução
# ERP_DEMO = "1"
