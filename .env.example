# Exemplo. O app reescreve o .env com os valores CRIPTOGRAFADOS (prefixo enc:) pela aba
# "Configurações de Conexão e Backup". Valores em texto puro abaixo também são aceitos e
# serão criptografados no próximo salvamento.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
S3_BUCKET=
S3_PREFIX=obra
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_BASE_DIR=/backup_obra
FTP_TLS=0
